# =============================================================================
# AgentWatch Range — Attack Panel Container v3
# Build context: repository root
# =============================================================================
FROM python:3.11-slim

LABEL maintainer="AgentWatch Range"
LABEL description="AgentWatch Range Multi-Stage Attack Simulator"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY apps/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY apps/exploit_ui.py .
COPY apps/framework/ ./framework/

RUN useradd -m -u 1000 appuser \
    && mkdir -p /var/log/defenseclaw \
    && chown -R appuser:appuser /app /var/log/defenseclaw

USER appuser

EXPOSE 5001
CMD ["python", "exploit_ui.py"]
