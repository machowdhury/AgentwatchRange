# =============================================================================
# AgentWatch Range — Banking App Container v3
# Build context: repository root
# =============================================================================
FROM python:3.11-slim

LABEL maintainer="AgentWatch Range"
LABEL description="ACME Banking Multi-Agent Fabric — Real Ollama LLM loop"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY apps/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY apps/app_runtime.py .
COPY apps/templates/ ./templates/
COPY apps/agents/ ./agents/
COPY apps/framework/ ./framework/
COPY scripts/baseline_hec_service.py ./scripts/baseline_hec_service.py
COPY data/ ./data/

RUN useradd -m -u 1000 appuser \
    && mkdir -p /var/log/acme_sentinel \
    && chown -R appuser:appuser /app /var/log/acme_sentinel

USER appuser

EXPOSE 5000
CMD ["python", "app_runtime.py"]
